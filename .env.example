# ─── Pulse Configuration ───────────────────────────────────────
# Copy this to .env.local and fill in your values.

# ─── Grafana ───────────────────────────────────────────────────
# Your Grafana instance URL and a service account API key (Viewer role)
GRAFANA_URL=https://grafana.yourcompany.com
GRAFANA_API_KEY=glsa_xxxxxxxxxxxx

# ─── Gong ──────────────────────────────────────────────────────
# Gong API credentials (Settings → API → Create API Key)
GONG_API_KEY=your-gong-api-key
GONG_API_SECRET=your-gong-api-secret

# ─── Pylon ─────────────────────────────────────────────────────
# Pylon API key (Settings → API)
PYLON_API_KEY=your-pylon-api-key

# ─── Slack ─────────────────────────────────────────────────────
# Slack Bot Token (xoxb-...) — see SETUP.md for required scopes
SLACK_BOT_TOKEN=xoxb-your-bot-token

# ─── Anthropic (Claude) ───────────────────────────────────────
# Your Anthropic API key for digest generation
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── Cron Security ────────────────────────────────────────────
# Random string to protect the cron endpoint from unauthorized access
# Generate one: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
